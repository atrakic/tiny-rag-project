{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "String",
      "defaultValue": "northeurope"
    },
    "containerAppEnvironmentName": {
      "type": "String",
      "defaultValue": "cae-tiny-rag"
    },
    "qdrantAppName": {
      "type": "String",
      "defaultValue": "qdrant"
    },
    "apiAppName": {
      "type": "String",
      "defaultValue": "tiny-rag-api"
    },
    "apiImage": {
      "type": "String",
      "defaultValue": "your-registry.azurecr.io/tiny-rag-server:latest"
    },
    "qdrantImage": {
      "type": "String",
      "defaultValue": "qdrant/qdrant:v1.13.0"
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2023-05-02-preview",
      "name": "[parameters('containerAppEnvironmentName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "none"
        }
      }
    },
    {
      "type": "Microsoft.App/containerapps",
      "apiVersion": "2023-05-02-preview",
      "name": "[parameters('qdrantAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 6333,
            "transport": "auto"
          },
          "activeRevisionsMode": "Single"
        },
        "template": {
          "containers": [
            {
              "name": "qdrant",
              "image": "[parameters('qdrantImage')]",
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerapps",
      "apiVersion": "2023-05-02-preview",
      "name": "[parameters('apiAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]",
        "[resourceId('Microsoft.App/containerapps', parameters('qdrantAppName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto"
          },
          "activeRevisionsMode": "Single"
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[parameters('apiImage')]",
              "env": [
                {
                  "name": "QDRANT_HOST",
                  "value": "[parameters('qdrantAppName')]"
                },
                {
                  "name": "QDRANT_PORT",
                  "value": "6333"
                },
                {
                  "name": "QDRANT_COLLECTION",
                  "value": "docs"
                },
                {
                  "name": "DATA_DIR",
                  "value": "/data"
                }
              ],
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      }
    }
  ]
}
